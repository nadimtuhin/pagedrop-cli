#!/usr/bin/env bash
# Stub curl: never touches the network. Behaviour is chosen by $FAKE; calls are recorded in $STUB_OUT.
out_file=""
data_stdin=0
maxarg=0
silent=0
show_error=0
for ((i = 1; i <= $#; i++)); do
  arg="${!i}"
  [ "${#arg}" -gt "$maxarg" ] && maxarg=${#arg}
  next=$((i + 1))
  case "$arg" in
    -s) silent=1 ;;
    -sS|-Ss|-S|--show-error) silent=1; show_error=1 ;;
    -o) out_file="${!next}" ;;
    --data-binary) [ "${!next}" = "@-" ] && data_stdin=1 ;;
  esac
done
echo "$maxarg" > "$STUB_OUT/maxarg"
[ "$data_stdin" = 1 ] && cat > "$STUB_OUT/payload"
if [ -n "$out_file" ]; then echo '#!/bin/sh' > "$out_file"; exit 0; fi
case "$FAKE" in
  ok) echo '{"url":"https://pagedrop.io/x/abc"}' ;;
  spaced) echo '{"url": "https://pagedrop.io/x/abc"}' ;;
  junk) echo 'oops not json' ;;
  off)
    # like real curl: -s alone hides the error message
    { [ "$silent" = 0 ] || [ "$show_error" = 1 ]; } && echo 'curl: (6) Could not resolve host: pagedrop.io' >&2
    exit 6 ;;
esac
