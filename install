#!/usr/bin/env bash
set -e

# One-command installer for pagedrop-cli
# Usage: curl -sSL https://raw.githubusercontent.com/nadimtuhin/pagedrop-cli/main/install | bash

REPO="nadimtuhin/pagedrop-cli"
INSTALL_DIR="$HOME/.local/bin"
SCRIPT_NAME="pagedrop"

# Detect system
OS="$(uname -s)"
ARCH="$(uname -m)"

if [ "$OS" != "Darwin" ]; then
  echo "Warning: This installer is optimized for macOS. Proceeding anyway..."
fi

# Create install dir if needed
mkdir -p "$INSTALL_DIR"

# Download script
echo "Downloading $SCRIPT_NAME from GitHub..."
if command -v curl &>/dev/null; then
  curl -fsSL "https://raw.githubusercontent.com/$REPO/main/pagedrop" -o "$INSTALL_DIR/$SCRIPT_NAME"
elif command -v wget &>/dev/null; then
  wget -qO "$INSTALL_DIR/$SCRIPT_NAME" "https://raw.githubusercontent.com/$REPO/main/pagedrop"
else
  echo "Error: curl or wget required"
  exit 1
fi

chmod +x "$INSTALL_DIR/$SCRIPT_NAME"

# Add to PATH if not already there
if [[ ":$PATH:" != *":$INSTALL_DIR:"* ]]; then
  SHELL_CONFIG=""
  # Under `curl | bash` this script always runs in bash, so read the user's login shell instead.
  case "$(basename "${SHELL:-}")" in
    zsh) SHELL_CONFIG="$HOME/.zshrc" ;;
    bash) SHELL_CONFIG="$HOME/.bashrc" ;;
  esac

  if [ -n "$SHELL_CONFIG" ] && [ -f "$SHELL_CONFIG" ]; then
    echo "" >> "$SHELL_CONFIG"
    echo "# pagedrop-cli install" >> "$SHELL_CONFIG"
    echo "export PATH=\"$INSTALL_DIR:\$PATH\"" >> "$SHELL_CONFIG"
    echo ""
    echo "Added $INSTALL_DIR to PATH in $SHELL_CONFIG"
    echo "Run 'source $SHELL_CONFIG' or restart your shell to use pagedrop."
  else
    echo ""
    echo "WARNING: $INSTALL_DIR not in PATH. Add it with:"
    echo "  export PATH=\"$INSTALL_DIR:\$PATH\""
  fi
fi

echo ""
echo "✓ Installed $SCRIPT_NAME to $INSTALL_DIR/$SCRIPT_NAME"
echo "Try: $SCRIPT_NAME --help"
