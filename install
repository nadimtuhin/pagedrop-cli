#!/usr/bin/env bash
set -euo pipefail

# One-command installer for pagedrop-cli
# Usage: curl -sSL https://raw.githubusercontent.com/nadimtuhin/pagedrop-cli/main/install | bash

REPO="nadimtuhin/pagedrop-cli"
INSTALL_DIR="$HOME/.local/bin"
SCRIPT_NAME="pagedrop"

# Detect system
OS="$(uname -s)"

if [ "$OS" != "Darwin" ]; then
  echo "Warning: This installer is optimized for macOS. Proceeding anyway..."
fi

# Create install dir if needed
mkdir -p "$INSTALL_DIR"

# Download to a temp file next to the target, then move it into place, so a failed
# or cut-off download never replaces a working install with a broken one.
echo "Downloading $SCRIPT_NAME from GitHub..."
TMP_FILE="$(mktemp "$INSTALL_DIR/.$SCRIPT_NAME.XXXXXX")"
trap 'rm -f "$TMP_FILE"' EXIT
if command -v curl &>/dev/null; then
  curl -fsSL "https://raw.githubusercontent.com/$REPO/main/pagedrop" -o "$TMP_FILE"
elif command -v wget &>/dev/null; then
  wget -qO "$TMP_FILE" "https://raw.githubusercontent.com/$REPO/main/pagedrop"
else
  echo "Error: curl or wget required" >&2
  exit 1
fi

if [ ! -s "$TMP_FILE" ]; then
  echo "Error: download of $SCRIPT_NAME was empty" >&2
  exit 1
fi
chmod +x "$TMP_FILE"
mv -f "$TMP_FILE" "$INSTALL_DIR/$SCRIPT_NAME"

# Add to PATH if not already there
if [[ ":$PATH:" != *":$INSTALL_DIR:"* ]]; then
  SHELL_CONFIG=""
  # Under `curl | bash` this script always runs in bash, so read the user's login shell instead.
  case "$(basename "${SHELL:-}")" in
    zsh) SHELL_CONFIG="$HOME/.zshrc" ;;
    bash)
      if [ "$OS" = "Darwin" ]; then
        # macOS terminals start bash as a login shell, which reads the first of these
        # and never reads ~/.bashrc.
        SHELL_CONFIG="$HOME/.bash_profile"
        for f in .bash_profile .bash_login .profile; do
          if [ -f "$HOME/$f" ]; then SHELL_CONFIG="$HOME/$f"; break; fi
        done
      else
        SHELL_CONFIG="$HOME/.bashrc"
      fi
      ;;
  esac

  if [ -n "$SHELL_CONFIG" ] && grep -qF "# pagedrop-cli install" "$SHELL_CONFIG" 2>/dev/null; then
    echo ""
    echo "$SHELL_CONFIG already adds $INSTALL_DIR to PATH."
    echo "Run 'source $SHELL_CONFIG' or restart your shell to use pagedrop."
  elif [ -n "$SHELL_CONFIG" ]; then
    # A stock macOS account has no ~/.zshrc yet; create it rather than skip PATH setup.
    {
      echo ""
      echo "# pagedrop-cli install"
      echo "export PATH=\"$INSTALL_DIR:\$PATH\""
    } >> "$SHELL_CONFIG"
    echo ""
    echo "Added $INSTALL_DIR to PATH in $SHELL_CONFIG"
    echo "Run 'source $SHELL_CONFIG' or restart your shell to use pagedrop."
  else
    echo ""
    echo "WARNING: $INSTALL_DIR not in PATH. Add it with:"
    echo "  export PATH=\"$INSTALL_DIR:\$PATH\""
  fi
fi

echo ""
echo "✓ Installed $SCRIPT_NAME to $INSTALL_DIR/$SCRIPT_NAME"
echo "Try: $SCRIPT_NAME --help"
